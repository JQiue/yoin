{
  "name": "yoin",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist/client",
    "dist/admin"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/client.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/admin.js"
    }
  },
  "scripts": {
    "build": "rsbuild build --environment client,admin",
    "client:build": "rsbuild build --environment client",
    "client:dev": "rsbuild dev --environment client --open",
    "client:preview": "rsbuild preview --environment client",
    "admin:build": "rsbuild build --environment admin",
    "admin:dev": "rsbuild dev --environment admin --open",
    "admin:preview": "rsbuild preview --environment admin",
    "biome": "biome check --write",
    "build:analyze": "BUNDLE_ANALYZE=true rsbuild build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "preact": "^10.29.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@rsbuild/core": "^1.7.3",
    "@rsbuild/plugin-preact": "^1.7.2",
    "@tailwindcss/postcss": "^4.2.2",
    "postcss-prefix-selector": "^2.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}