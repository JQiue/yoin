{
	"name": "yoin",
	"version": "0.0.1",
	"type": "module",
	"files": [
		"dist/client",
		"dist/admin"
	],
	"exports": {
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/client.js"
		},
		"./admin": {
			"types": "./dist/admin/index.d.ts",
			"default": "./dist/admin/admin.js"
		}
	},
	"scripts": {
		"build": "rsbuild build --environment client,admin",
		"build:client": "rsbuild build --environment client",
		"dev:client": "rsbuild dev --environment client --open",
		"preview:client": "rsbuild preview --environment client",
		"build:admin": "rsbuild build --environment admin",
		"dev:admin": "rsbuild dev --environment admin --open",
		"preview:admin": "rsbuild preview --environment admin",
		"biome": "biome check --write",
		"build:analyze": "BUNDLE_ANALYZE=true rsbuild build"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.563.0",
		"preact": "^10.28.2",
		"radix-ui": "^1.4.3",
		"tailwind-merge": "^3.4.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@rsbuild/core": "^1.7.1",
		"@rsbuild/plugin-preact": "^1.7.1",
		"@tailwindcss/postcss": "^4.1.18",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3"
	}
}